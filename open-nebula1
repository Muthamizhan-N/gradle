echo 'deb [signed-by=/etc/apt/keyrings/opennebula.gpg] https://downloads.opennebula.io/repo/7.2/Ubuntu/24.04 stable opennebula' | sudo tee /etc/apt/sources.list.d/opennebula.list > /dev/null

sudo apt update

